{
  "compilerOptions": {
    "tsBuildInfoFile": ".tmp/tsbuildinfo.web.json",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/renderer/src/**/*.tsx", "src/renderer/src/**/*.ts", "src/renderer/src/components/**/*.tsx", "src/renderer/src/pages/**/*.tsx"]
}
